{
  "manifest_version": 2,
  "name": "Прочитай мне",
  "version": "1.2",
  "description": "Выдели текст — плагин его прочитает (Web Speech API, без внешних сервисов)",
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "commands": {
    "read-selection": {
      "suggested_key": {
        "default": "Alt+R"
      },
      "description": "Прочитать выделенное"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon.svg"
  },
  "icons": {
    "48": "icons/icon.svg"
  }
}
